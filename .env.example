# Copy to .env at the project root. Never commit real credentials.
MINERU_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm

# All five GPT dropdown models share this key and Responses endpoint.
CODEX_API_KEY=
CODEX_BASE_URL=
REVIEW_CODEX_MODEL=gpt-6.1-sol
REVIEW_CODEX_BIN=codex
# Conservative full-input context check. Set these to your provider's actual limits.
REVIEW_CODEX_CONTEXT_TOKENS=1050000
REVIEW_CODEX_OUTPUT_TOKENS=12000

# DeepSeek Flash / Pro share this key and Chat Completions endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_CONTEXT_TOKENS=1000000
DEEPSEEK_OUTPUT_TOKENS=12000

# Empty REVIEW_DATA_DIR uses the project-root data directory.
REVIEW_PORT=4173
REVIEW_DATA_DIR=
# MySQL connection (5.7 or newer). The account needs full rights on MYSQL_DATABASE;
# tests also create and drop throwaway databases named wenheng_test_*.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=wenheng
MYSQL_PASSWORD=
MYSQL_DATABASE=wenheng
# Deployment behind a reverse proxy: listen address and extra host names (comma separated) the app accepts.
REVIEW_HOST=
REVIEW_ALLOWED_HOSTS=
PDFTOPPM_BIN=pdftoppm
